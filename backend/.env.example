# Optional integrations. Keep real values only in ignored backend/.env.
NESSIE_API_KEY=
SERPAPI_API_KEY=
GEMINI_API_KEY=

# Build Sheet 01 only calls Nessie. The other keys are reserved for later sheets.
NESSIE_BASE_URL=https://prod-api.nessieisreal.com

# auto: use seeded Nessie when configured, otherwise show the labeled fixture.
# fixture: never call Nessie. nessie: fail instead of falling back.
DEMO_DATA_MODE=auto
DEMO_ANCHOR_DATE=2026-10-24
SEED_MANIFEST_PATH=.local/nessie-seed.json

# Local frontend origin allowed for direct browser requests to FastAPI.
FRONTEND_ORIGIN=http://localhost:3000
